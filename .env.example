# Connexion PostGIS. Copiez ce fichier vers .env pour le modifier.
# Par défaut : le conteneur docker compose de ce projet (port 5433).

PGHOST=127.0.0.1
PGPORT=5433
PGUSER=osm
PGPASSWORD=osm
PGDATABASE=osm

# Port du serveur web (python3 serve.py).
# 8001 pour cohabiter avec pmtiles qui écoute souvent sur 8000.
OSM2POSTGIS_PORT=8001
